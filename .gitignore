# =============================================================================

# BSTU International Website — Git Ignore Rules

# =============================================================================

#

# Monorepo:

# apps/web  -> React 19 + Vite + Tailwind CSS 4

# apps/api  -> Laravel 13 + MySQL

#

# Durable repository guidance such as README.md, AGENTS.md, and SKILL.md

# must remain tracked.

# =============================================================================

# =============================================================================

# Dependencies

# =============================================================================

node_modules/
vendor/

**/node_modules/
**/vendor/

# =============================================================================

# Frontend Build Outputs

# =============================================================================

dist/
build/

**/dist/
**/build/

# Vite temporary/cache directories

.vite/
**/.vite/

# Optional framework/cache outputs

.cache/
**/.cache/

# =============================================================================

# Environment Files / Secrets

# =============================================================================

.env
.env.*
**/.env
**/.env.*

# Environment templates are intentionally tracked

!.env.example
!**/.env.example
!apps/api/.env.example
!apps/web/.env.example

# =============================================================================

# Laravel Runtime / Generated Files

# =============================================================================

apps/api/storage/*

# Preserve Laravel directory structure

!apps/api/storage/.gitignore

!apps/api/storage/app/
!apps/api/storage/app/.gitignore

!apps/api/storage/framework/
!apps/api/storage/framework/.gitignore

!apps/api/storage/framework/cache/
!apps/api/storage/framework/cache/.gitignore

!apps/api/storage/framework/sessions/
!apps/api/storage/framework/sessions/.gitignore

!apps/api/storage/framework/views/
!apps/api/storage/framework/views/.gitignore

!apps/api/storage/logs/
!apps/api/storage/logs/.gitignore

# Laravel bootstrap runtime cache

apps/api/bootstrap/cache/*

!apps/api/bootstrap/cache/.gitignore

# Laravel public storage symlink / Windows junction

#

# apps/api/public/storage points to storage/app/public and must not be

# committed as a duplicate upload directory.

apps/api/public/storage

# Laravel development server hot file if generated

apps/api/public/hot

